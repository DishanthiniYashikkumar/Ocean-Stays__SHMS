# Copy to .env and fill in. Never commit .env.
# Neon: copy the pooled connection string from the Neon Console (keep sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:\d+,http://127\.0\.0\.1:\d+
APP_TIMEZONE=Asia/Colombo
FLASK_DEBUG=0
